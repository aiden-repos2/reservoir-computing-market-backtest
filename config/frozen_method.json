    "row_filter": "drop rows with missing next-session return",
    "missing_feature_policy": "replace missing model-input values with 0.0"
  },
  "ikeda": {
    "virtual_nodes": 200,
    "theta_steps": 10,
    "dt": 0.08661933269857963,
    "feedback_gain_beta": 0.3441984642966166,
    "phase_offset": 1.1583611813967833,
    "input_scale": 0.013175730055118363,
    "auxiliary_delta": 0.0,
    "desynchronization": 7,
    "mask_mode": "binary",
    "mask_seed": 1234
  },
  "readout": {
    "type": "ridge",
    "penalty": 1.0,
    "intercept_penalized": true,
    "score_transform": "1 / (1 + exp(-4 * score))",
    "expanding_window": true,
    "walk_forward_anchor": "first row on or after 2016-01-01",
    "refit_every_sessions": 21,
    "embargo_sessions": 5,
    "reporting_slice": "select rows on or after 2024-01-01 after continuous scoring"
