{
  "schema_version": "1.0.0",
  "scope": "historical_method_reconstruction_not_full_public_refit",
  "symbols": ["SPY", "QQQ", "XLK", "XLF", "XLE", "XLV", "XLI", "TLT", "GLD"],
  "input_contract": {
