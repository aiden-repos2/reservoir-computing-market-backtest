  "volatility_sizing": {
    "model": "HAR-style expanding ridge on current log volatility and trailing 5- and 21-session means",
    "target": "next-session log volatility",
    "initial_training_sessions": 504,
    "penalty": 0.0001,
    "intercept_penalized": true,
    "refit_every_sessions": 21,
    "embargo_sessions": 5,
    "prefit_fallback": "current log volatility"
  },
  "portfolio": {
    "annual_volatility_target": 0.1,
    "annualization_sessions": 252,
    "maximum_absolute_weight": 1.0,
    "cost_basis_points_per_absolute_weight_change": 2.5,
    "position_and_cost_stream": "continuous from the 2016 walk-forward anchor; the 2024 reporting slice does not reset the prior weight",
    "cross_symbol_aggregation": "equal_weight_on_common_dates"
  },
  "periods": {
    "development_evaluation": ["2016-01-01", "2023-12-31"],
    "historical_holdout": ["2024-01-02", "2026-07-06"]
